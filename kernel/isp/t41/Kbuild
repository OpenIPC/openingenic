MODULE_NAME := tx-isp-$(SOC)
OUT := $(MODULE_NAME)

DIR=isp/$(SOC)

SRCS := \
  $(DIR)/tx-isp-funcs.c \
  $(DIR)/tx-isp-module.c

# T41 ships blobs for both vendor kernels. Pick by the kernel being built
# (VERSION/PATCHLEVEL/SUBLEVEL come from its top Makefile), not by KDIR,
# which Buildroot and a plain `make -C <kernel> M=$PWD` never set.
ifeq ($(SOC),t41)
  KVERSION := $(VERSION)-$(PATCHLEVEL)-$(SUBLEVEL)
else ifeq ($(SOC),t40)
  KVERSION := 4-4-94
endif

OBJS := $(SRCS:%.c=%.o) $(ASM_SRCS:%.S=%.o)
OBJS += $(DIR)/libt41-firmware-$(KVERSION).a

$(OUT)-objs := $(OBJS)

obj-m += $(OUT).o

# The T41 ISP blob is built with Ingenic's -mmxu3: its ELF header carries
# e_flags 0x800 (`mxu3.x` to the SDK's readelf), which upstream binutils
# does not know and refuses to merge with our objects. The vendor's own
# tx-isp-t41.ko links this same blob (same md5) and keeps the flag, so
# tell ld not to enforce it -- on this module only, both at the -r link
# and at the .ko link -- rather than editing the blob.
ifeq ($(SOC),t41)
%/$(OUT).o: ldflags-y += --no-warn-mismatch
%/$(OUT).ko: LDFLAGS_MODULE += --no-warn-mismatch
endif
