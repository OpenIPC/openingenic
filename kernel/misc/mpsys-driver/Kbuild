MODULE_NAME := mpsys_driver
OUT := $(MODULE_NAME)

DIR=misc/mpsys-driver

SRCS := \
  $(DIR)/mpsys_module.c \
  $(DIR)/private-funcs.c

# T41 ships blobs for both vendor kernels. Pick by the kernel being built
# (VERSION/PATCHLEVEL/SUBLEVEL come from its top Makefile), not by KDIR,
# which Buildroot and a plain `make -C <kernel> M=$PWD` never set.
ifeq ($(SOC),t41)
  KVERSION := $(VERSION)-$(PATCHLEVEL)-$(SUBLEVEL)
else ifeq ($(SOC),t40)
  KVERSION := 4-4-94
endif

OBJS := $(SRCS:%.c=%.o) $(ASM_SRCS:%.S=%.o)
OBJS += $(DIR)/$(SOC)-mpsys-firmware-$(KVERSION).a

$(OUT)-objs := $(OBJS)

obj-m += $(OUT).o

